{
  "name": "crypto-trader-bot",
  "version": "1.0.0",
  "description": "A simple crypto trading bot using SMA crossover strategy and Binance Testnet API.",
  "main": "dist/bot.js",
  "scripts": {
    "start": "ts-node src/bot.ts",
    "dev": "ts-node-dev --respawn src/bot.ts",
    "build": "tsc",
    "prod": "npm run build && node dist/bot.js"
  },
  "keywords": [
